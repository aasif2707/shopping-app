{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200"
  },
  "DatabaseSettings": {
    "ConnectionString": "mongodb://catalogdb:27017?readPreference=primary&ssl=False",
    "Database": "CatalogDb",
    "ProductCollection": "Products",
    "BrandCollection": "Brands",
    "TypeCollection": "Types"
  },
  "IdentityAuthority": "http://identity.api:8004",
  "Jwt": {
    "Key": "Password@123",
    "Issuer": "http://host.docker.internal:8004/",
    "Audience": "http://host.docker.internal:8000/"
  }
}
