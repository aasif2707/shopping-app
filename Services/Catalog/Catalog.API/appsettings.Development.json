{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200"
  },
  "DatabaseSettings": {
    "ConnectionString": "mongodb://admin:Password123@catalogdb:27017/?authSource=admin",
    "Database": "CatalogDb",
    "ProductCollection": "Products",
    "BrandCollection": "Brands",
    "TypeCollection": "Types"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "https://localhost:4200",
      "https://127.0.0.1:4200"
    ]
  }
}
