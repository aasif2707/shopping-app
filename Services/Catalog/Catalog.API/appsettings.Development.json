{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200"
  },
  "DatabaseSettings": {
    "ConnectionString": "mongodb://localhost:27017?readPreference=primary&ssl=False",
    "Database": "CatalogDb",
    "ProductCollection": "Products",
    "BrandCollection": "Brands",
    "TypeCollection": "Types"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:9006",
      "http://127.0.0.1:9006",
      "https://localhost:9006",
      "https://127.0.0.1:9006"
    ]
  },
  "IdentityAuthority": "https://localhost:9004",
  "Jwt": {
    "Key": "Password@123",
    "Issuer": "https://localhost:9004/",
    "Audience": "https://localhost:9000/"
  }
