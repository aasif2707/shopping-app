{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200"
  },
  "CacheSettings": {
    "ConnectionString": "basketdb:6379"
  },
  "GrpcSettings": {
    "DiscountUrl": "http://host.docker.internal:8002"
  },
  "EventBusSettings": {
    "HostAddress": "amqp://guest:guest@host.docker.internal:5672"
  },
  "Loki": {
    "HostAddress": "http://loki:3100/loki/api/v1/push"
  }
}
