{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200"
  },
  "CacheSettings": {
    "ConnectionString": "basketdb:6379"
  },
  "GrpcSettings": {
    "DiscountUrl": "http://discount.api"
  },
  "EventBusSettings": {
    "HostAddress": "amqp://guest:guest@rabbitmq:5672"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:9006",
      "http://127.0.0.1:9006",
      "https://localhost:9006",
      "https://127.0.0.1:9006"
    ]
  }
}
