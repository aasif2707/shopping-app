{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200"
  },
  "CacheSettings": {
    "ConnectionString": "localhost:6379"
  },
  "GrpcSettings": {
    "DiscountUrl": "http://localhost:8002"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:9006",
      "http://127.0.0.1:9006",
      "https://localhost:9006",
      "https://127.0.0.1:9006"
    ]
  }
}
